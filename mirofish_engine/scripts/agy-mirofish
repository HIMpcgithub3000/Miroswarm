#!/bin/bash
# ==============================================================================
# agy-mirofish
# Antigravity CLI Command & Process Manager for MiroFish
# Allows 100% Zero-Credit, Local Multi-Agent Swarm Simulations
# ==============================================================================

set -e

PROJECT_DIR="/Users/himanshusharma/.gemini/antigravity/scratch/MiroFish"
BACKEND_DIR="$PROJECT_DIR/backend"
FRONTEND_DIR="$PROJECT_DIR/frontend"
VENV_PYTHON="$BACKEND_DIR/venv/bin/python3"

# Colors for terminal styling
CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color
BOLD='\033[1m'

print_banner() {
  echo -e "${CYAN}${BOLD}"
  echo "  ███╗   ███╗██╗██████╗  ██████╗ ███████╗██╗███████╗██╗  ██╗"
  echo "  ████╗ ████║██║██╔══██╗██╔═══██╗██╔════╝██║██╔════╝██║  ██║"
  echo "  ██╔████╔██║██║██████╔╝██║   ██║█████╗  ██║███████╗███████║"
  echo "  ██║╚██╔╝██║██║██╔══██╗██║   ██║██╔══╝  ██║╚════██║██╔══██║"
  echo "  ██║ ╚═╝ ██║██║██║  ██║╚██████╔╝██║     ██║███████║██║  ██║"
  echo "  ╚═╝     ╚═╝╚═╝╚═╝  ╚═╝ ╚═════╝ ╚═╝     ╚═╝╚══════╝╚═╝  ╚═╝"
  echo -e "${NC}"
  echo -e "${GREEN}  ⚡ Antigravity CLI Compatibility Engine // Zero-Credit Edition${NC}"
  echo "  ------------------------------------------------------------"
}

check_ollama() {
  if curl -s http://127.0.0.1:11434/api/tags >/dev/null 2>&1; then
    echo -e "  ${GREEN}✓${NC} Local Ollama LLM Engine: ${GREEN}Active (gemma3:4b ready)${NC}"
  else
    echo -e "  ${YELLOW}!${NC} Local Ollama is offline. (Antigravity synthetic fallback will engage if needed)."
  fi
}

cmd_start() {
  print_banner
  echo -e "\n${BOLD}[1/3] Verifying Zero-Credit Execution Engine...${NC}"
  check_ollama

  echo -e "\n${BOLD}[2/3] Launching MiroFish Backend on port 5001...${NC}"
  # Kill existing backend if running
  lsof -ti :5001 | xargs kill -9 2>/dev/null || true
  cd "$BACKEND_DIR"
  nohup "$VENV_PYTHON" run.py > "$BACKEND_DIR/backend.log" 2>&1 &
  BACKEND_PID=$!
  sleep 1.5

  if ps -p $BACKEND_PID > /dev/null; then
    echo -e "  ${GREEN}✓${NC} Backend listening at: ${BOLD}http://localhost:5001${NC} (PID: $BACKEND_PID)"
  else
    echo -e "  ${RED}✗${NC} Backend failed to start. Log output:"
    tail -n 15 "$BACKEND_DIR/backend.log"
    exit 1
  fi

  echo -e "\n${BOLD}[3/3] Launching MiroFish Modern UI on port 3000...${NC}"
  lsof -ti :3000 | xargs kill -9 2>/dev/null || true
  cd "$FRONTEND_DIR"
  nohup npm run dev < /dev/null > "$FRONTEND_DIR/frontend.log" 2>&1 &
  FRONTEND_PID=$!
  sleep 2

  echo -e "  ${GREEN}✓${NC} Frontend UI online at: ${BOLD}http://localhost:3000${NC}"
  echo -e "\n${GREEN}${BOLD}🚀 MiroFish Antigravity System Ready!${NC}"
  echo -e "   • Open in Browser: ${CYAN}http://localhost:3000${NC}"
  echo -e "   • Backend API:     ${CYAN}http://localhost:5001/api${NC}"
  echo -e "   • Logs:            ${YELLOW}tail -f $BACKEND_DIR/backend.log${NC}\n"
}

cmd_stop() {
  print_banner
  echo -e "${YELLOW}Stopping all running MiroFish processes...${NC}"
  lsof -ti :5001 | xargs kill -9 2>/dev/null || true
  lsof -ti :3000 | xargs kill -9 2>/dev/null || true
  pkill -f "run.py" 2>/dev/null || true
  pkill -f "run_parallel_simulation.py" 2>/dev/null || true
  echo -e "${GREEN}✓ All MiroFish processes stopped.${NC}"
}

cmd_status() {
  print_banner
  echo -e "${BOLD}MiroFish Antigravity Status:${NC}"
  check_ollama

  BACKEND_CHECK=$(lsof -ti :5001 2>/dev/null || echo "")
  FRONTEND_CHECK=$(lsof -ti :3000 2>/dev/null || echo "")

  if [ -n "$BACKEND_CHECK" ]; then
    echo -e "  • Backend (Port 5001):  ${GREEN}ONLINE (PID: $BACKEND_CHECK)${NC}"
  else
    echo -e "  • Backend (Port 5001):  ${RED}OFFLINE${NC}"
  fi

  if [ -n "$FRONTEND_CHECK" ]; then
    echo -e "  • Frontend (Port 3000): ${GREEN}ONLINE (PID: $FRONTEND_CHECK)${NC}"
  else
    echo -e "  • Frontend (Port 3000): ${RED}OFFLINE${NC}"
  fi

  GRAPHS_COUNT=$(ls -1 "$BACKEND_DIR/app/uploads/local_graphs" 2>/dev/null | wc -l | tr -d ' ')
  echo -e "  • Local Knowledge Graphs: ${CYAN}${GRAPHS_COUNT} cached${NC}"
  echo -e "  • API Credit Balance:   ${GREEN}Unlimited (Local Antigravity Mode)${NC}\n"
}

cmd_test() {
  print_banner
  echo -e "${BOLD}Running MiroFish Self-Test...${NC}"
  cd "$BACKEND_DIR"
  "$VENV_PYTHON" -c "
from app import create_app
from app.config import Config
print('✓ Config validation:', 'PASS' if not Config.validate() else Config.validate())
app = create_app()
client = app.test_client()
res = client.get('/api/graph/health')
print('✓ Backend Graph API test:', res.status_code)
"
}

case "$1" in
  start)
    cmd_start
    ;;
  stop)
    cmd_stop
    ;;
  status)
    cmd_status
    ;;
  test)
    cmd_test
    ;;
  *)
    print_banner
    echo "Usage: agy-mirofish {start|stop|status|test}"
    echo ""
    echo "Commands:"
    echo "  start    Launch backend (port 5001) and frontend (port 3000) in Antigravity mode"
    echo "  stop     Halt all background MiroFish processes"
    echo "  status   Inspect running server ports and local engine health"
    echo "  test     Run quick diagnostic check of API endpoints"
    echo ""
    ;;
esac
